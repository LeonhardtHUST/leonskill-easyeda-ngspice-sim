{
  "version": 2,
  "comment": "复杂仿真主入口。所有相对路径都相对本文件所在目录解析。",
  "power_policy": "explicit",
  "strict": true,
  "allow_partial_model": false,
  "max_cases": 200,
  "ground_aliases": {
    "0": [
      "GND",
      "GROUND"
    ],
    "AGND": [
      "AGND"
    ],
    "DGND": [
      "DGND"
    ]
  },
  "external_supplies": [
    {
      "net": "13V8",
      "voltage": 13.8
    },
    {
      "net": "VIN_LAB",
      "voltage": 12.0
    }
  ],
  "models": "model_map.json",
  "behavioral_models": "behavioral.json",
  "override": "sim_override.json",
  "analysis": {
    "mode": "tran",
    "args": "10p 120n"
  },
  "fidelity_labels": {
    "U1": "power stage (buck)",
    "U2": "power stage (LDO)",
    "DA1": "ADC load",
    "U5": "FPGA core",
    "_routing": "clock routing / PDN parasitics"
  },
  "sweep": [
    {
      "name": "R_CLK_DAMP",
      "values": [
        0,
        10,
        22,
        33,
        47,
        68
      ]
    },
    {
      "name": "C_HF",
      "values": [
        "47n",
        "100n",
        "220n"
      ]
    }
  ],
  "metrics": [
    {
      "name": "adc_overshoot",
      "metric": "tran_stats",
      "node": "$CLK_ADC",
      "t0": 6e-08
    },
    {
      "name": "adc_cross",
      "metric": "threshold_crossings",
      "node": "$CLK_ADC",
      "threshold": 1.65,
      "t0": 6e-08
    },
    {
      "name": "clk_skew",
      "metric": "time_delta",
      "a": "$CLK_ADC@1.65",
      "b": "$CLK_FPGA@1.65",
      "t0": 6e-08
    },
    {
      "name": "avdd_ripple",
      "metric": "tran_stats",
      "node": "AVDD",
      "t0": 2e-05
    },
    {
      "name": "avdd_z",
      "metric": "impedance",
      "node": "AVDD",
      "amplitude": 1,
      "at": [
        10000.0,
        100000.0,
        1000000.0,
        10000000.0,
        100000000.0
      ]
    },
    {
      "name": "pwm_harm",
      "metric": "fft_harmonics",
      "node": "I(V1)",
      "f0": 100000,
      "n": 5,
      "t0": 3e-05,
      "t1": 6e-05
    }
  ]
}