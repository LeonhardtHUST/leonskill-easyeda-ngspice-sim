{
  "version": 2,
  "power_policy": "explicit",
  "strict": false,
  "ground_aliases": {
    "0": [
      "GND",
      "GROUND"
    ]
  },
  "models": "model_map.json",
  "behavioral_models": "behavioral.json",
  "override": "sim_override.json",
  "comment": "Case G：clock 分支的蒙特卡洛（阻尼/耦合容差/负载电流）",
  "analysis": {
    "mode": "tran",
    "args": "10p 120n"
  },
  "metrics": [
    {
      "name": "adc",
      "metric": "tran_stats",
      "node": "$CLK_ADC",
      "t0": 6e-08
    },
    {
      "name": "adc_cross",
      "metric": "threshold_crossings",
      "node": "$CLK_ADC",
      "threshold": 1.65,
      "t0": 6e-08
    }
  ],
  "montecarlo": {
    "cases": 12,
    "seed": 1234,
    "workers": 4,
    "parameters": {
      "R_CLK_DAMP": {
        "nominal": "22",
        "distribution": "uniform",
        "tolerance_percent": 20
      },
      "C1": {
        "nominal": "220p",
        "distribution": "gaussian",
        "sigma_percent": 5
      },
      "R_TERM_ADC": {
        "nominal": "100",
        "distribution": "discrete",
        "values": [
          "91",
          "100",
          "110"
        ]
      }
    },
    "criteria": [
      {
        "metric": "adc.overshoot_pct",
        "op": "<",
        "value": 25.0
      }
    ]
  }
}