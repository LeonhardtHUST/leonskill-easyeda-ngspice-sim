    "0": [
      "GND",
      "GROUND"
    ],
    "AGND": [
      "AGND"
    ]
  },
  "segments": [
    {
      "net": "AGND",
      "endpoints": {
        "C2.2": "$AGND_CP2"
      }
    }
  ],
  "parasitics": [
    {
      "name": "TRACE_AVDD",
      "element_names": [
        "R_ADC_TRACE",
        "L_ADC_TRACE"
