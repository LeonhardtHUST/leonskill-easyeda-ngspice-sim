        "R_VIA_1",
        "L_VIA_1"
      ],
      "source": "engineering_estimate"
    },
    {
      "name": "VIA_AGND_C2",
      "type": "series_rl",
      "from": "$AGND_CP2",
      "to": "AGND",
      "r": "1m",
      "l": "0.6n",
      "source": "engineering_estimate",
      "element_names": [
        "R_VIA_GND",
        "L_VIA_GND"
      ]
    },
    {
      "name": "AGND_LINK",
      "element_name": "R_AGND_LINK",
      "type": "series_rl",
      "from": "AGND",
      "to": "GND",
      "r": "1m",
      "l": "1.5n",
      "source": "engineering_estimate"
    }
  ],
  "component_parasitics": [
    {
      "component": "C1",
      "model": {
        "C": "10u",
        "ESR": "5m",
        "ESL": "1.2n"
      },
